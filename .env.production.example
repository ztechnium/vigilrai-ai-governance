# ============================================================================
# VigilRAI Community Edition — production environment template
# Powered by Ztechnium. One organization. Not a multi-tenant service.
# ============================================================================
# SECURITY: Never commit actual secrets. Copy this file and fill in real values.
# ============================================================================

# ============================================================================
# CRITICAL SECURITY SETTINGS (MUST CHANGE FOR PRODUCTION)
# ============================================================================

# Environment Setting (Phase 21)
# REQUIRED: Set to "production" to enable security validation
# Options: development | staging | production
ENVIRONMENT=production

# JWT Secret Key (Phase 0-1)
# CRITICAL: Generate a strong random secret (64+ characters)
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_STRONG_SECRET_64_CHARS_OR_MORE

# Evidence Encryption Key (Phase 0)
# CRITICAL: Generate a strong random secret (64+ characters)
# Used for encrypting sensitive trajectory data
EVIDENCE_ENCRYPTION_KEY=CHANGE_ME_STRONG_SECRET_64_CHARS_OR_MORE

# Admin Bootstrap (Phase 22)
# CRITICAL: Disable automatic bootstrap admin creation in production
ADMIN_BOOTSTRAP_ENABLED=false
# Only used when ADMIN_BOOTSTRAP_ENABLED=true (dev/staging). Prefer CLI provisioning in prod.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
ADMIN_BOOTSTRAP_NAME=General Admin
ADMIN_BOOTSTRAP_ROLE=admin

# Admin Token (Legacy, Phase 21)
# CRITICAL: If used, must be strong and rotated regularly
# Prefer using the new explicit admin provisioning via CLI
ADMIN_TOKEN=

# Step-Up Token (Phase 21)
# CRITICAL: Required if step-up verification is enabled
# Generate strong random token if using shared-secret step-up
STEP_UP_TOKEN=
ALLOW_SHARED_SECRET_STEP_UP=false

# CORS Configuration (Phase 23)
# CRITICAL: Set explicit allowed origins, NEVER use "*" in production
# Comma-separated list of allowed origins (exact match)
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-CSRF-Token,X-Admin-Token,X-RAI-Agent-Key
CORS_MAX_AGE=600

# ============================================================================
# BROWSER SESSION SECURITY (Phase 20)
# ============================================================================

# Cookie-Based Authentication
# Enable HttpOnly cookies for browser sessions (recommended)
AUTH_SET_COOKIES=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_COOKIE_NAME=rai_access
AUTH_REFRESH_COOKIE_NAME=rai_refresh

# Token Expiration
# Access JWT lifetime (minutes). UI also refreshes via refresh_token before expiry.
# Values > 60 log a production warning when cookie auth is enabled.
AUTH_ACCESS_TOKEN_MINUTES=480
AUTH_REFRESH_TOKEN_DAYS=30
# Legacy JWT access TTL used by some admin/session paths (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Public URL for CSRF and redirect validation
APP_PUBLIC_URL=https://app.example.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DATABASE_URL=postgresql://user:password@db-host:5432/rai_gateway_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# ============================================================================
# EMAIL CONFIGURATION (Phase 21 - Optional but Recommended)
# ============================================================================

# Email Enabled (for user verification, password reset)
EMAIL_ENABLED=true

# Email Provider (resend, smtp, sendgrid, etc.)
EMAIL_PROVIDER=resend

# Email From Address
EMAIL_FROM_NAME=VigilRAI
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=support@example.com

# SMTP Configuration (if using SMTP provider)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_TIMEOUT_SECONDS=15.0

# Email Token TTLs
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# Documentation URL for email templates
EMAIL_DOCS_URL=https://docs.example.com

# ============================================================================
# MTLS & IDENTITY (Phase 21)
# ============================================================================

# mTLS Configuration
# CRITICAL: Never trust public cert headers without verification
MTLS_TRUSTED_PROXY_MODE=false
MTLS_TRUSTED_PROXY_SECRET=
MTLS_ALLOW_INSECURE_IDENTITY_HEADER=false

# ============================================================================
# MCP ADAPTER SECURITY (Phase 21)
# ============================================================================

# MCP Mode (PRODUCTION mode denies missing endpoints)
MCP_ADAPTER_MODE=PRODUCTION

# MCP Allowed Hosts (comma-separated, exact or *.suffix)
# Empty = no hostname allowlist (deny all external)
MCP_ALLOWED_HOSTS=api.example.com,*.internal.example.com

# MCP Security Flags (keep false in production)
MCP_ALLOW_PRIVATE_HOSTS=false
MCP_ALLOW_HTTP=false

# ============================================================================
# STEP-UP VERIFICATION (Phase 21)
# ============================================================================

# Human Approval Step-Up Requirements
REQUIRE_STEP_UP=true

# OIDC Requirements for Step-Up (optional)
APPROVAL_MINIMUM_ACR=
APPROVAL_REQUIRED_AMR=
APPROVAL_MAX_AUTH_AGE_SECONDS=

# ============================================================================
# ENTERPRISE IDP (Optional)
# ============================================================================

# Admin OIDC for SSO (optional)
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
ADMIN_OIDC_EMAIL_CLAIM=email

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# Primary LLM Provider
LLM_PROVIDER=openai
LLM_PROVIDER_URL=https://api.openai.com/v1
LLM_PROVIDER_MODEL=gpt-4
LLM_PROVIDER_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Azure OpenAI (if using)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic Claude (if using)
ANTHROPIC_API_KEY=

# AWS Bedrock (if using)
AWS_REGION=us-east-1

# Google Vertex AI (if using)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Ollama (local/on-prem LLM runtime)
OLLAMA_ENDPOINT=http://localhost:11434

# ============================================================================
# CACHE & OBSERVABILITY
# ============================================================================

# Redis Cache
REDIS_URL=redis://redis-host:6379
CACHE_TTL_SECONDS=3600
ENABLE_CACHE=true

# Logging
LOG_LEVEL=INFO

# OpenTelemetry (optional)
OTEL_ENDPOINT=

# SIEM Integration (optional)
SIEM_ENDPOINT=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_CASES=true
ENABLE_RAG=false
ENABLE_JUDGE=false
ENABLE_XAI=true
ENABLE_ETHICS_EVAL=true

# ============================================================================
# RUNTIME EXECUTION
# ============================================================================

# Runtime API Key Requirement
REQUIRE_API_KEY=true

# Fail-Closed on RAI Unavailable
FAIL_CLOSED_ON_RAI_UNAVAILABLE=true

# ============================================================================
# SDK & PRODUCTIZATION
# ============================================================================

SDK_RATE_LIMIT_PER_MINUTE=600
SDK_AUTH_FAILURE_LIMIT_PER_MINUTE=30

# Object Storage
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=rai-artifacts-prod
OBJECT_STORAGE_ENDPOINT=

# OIDC for SDK
OIDC_JWKS_URL=

# ============================================================================
# EVIDENCE HANDLING
# ============================================================================

# WP5 Evidence Content Defaults
# Prompt and output stay visible on trajectories (secrets still redacted).
# Tool parameters and results stay metadata-only while demo defaults are off.
EVIDENCE_USE_DEMO_CONTENT_DEFAULTS=false
EVIDENCE_PROMPT_HANDLING_MODE=REDACTED
EVIDENCE_MODEL_REQUEST_HANDLING_MODE=REDACTED
EVIDENCE_MODEL_RESPONSE_HANDLING_MODE=REDACTED
EVIDENCE_AGENT_OUTPUT_HANDLING_MODE=REDACTED
EVIDENCE_TOOL_PARAMETERS_HANDLING_MODE=
EVIDENCE_TOOL_RESULT_HANDLING_MODE=

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Data Classification Service (optional)
DATA_CLASSIFICATION_URL=

# ============================================================================
# FRONTEND (control-plane-ui / Docker)
# ============================================================================

# Browser-facing API base URL (build arg + runtime for Next.js)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Legacy admin token for UI bootstrap flows (prefer cookie/JWT session auth)
NEXT_PUBLIC_ADMIN_TOKEN=

# ============================================================================
# BUILD METADATA (optional — set in CI)
# ============================================================================

GIT_COMMIT_SHA=
BUILD_TIME=
SCHEMA_REVISION=

# ============================================================================
# LEGACY SETTINGS (Avoid if possible)
# ============================================================================

# Admin Session (if not using cookie-based auth)
ADMIN_SESSION_MINUTES=480

# JWT Algorithm
JWT_ALGORITHM=HS256

# ============================================================================
# DOCKER COMPOSE NOTES
# ============================================================================
# docker-compose.yml loads host `.env` (env_file) and overrides DATABASE_URL /
# REDIS_URL for the internal Docker network. Copy this file to `.env` (or export
# the same keys) so these settings reach the rai-gateway container.
# Example:
#   cp .env.production.example .env
#   # edit secrets, then:
#   docker compose up -d

# ============================================================================
# END OF PRODUCTION CONFIGURATION
# ============================================================================
