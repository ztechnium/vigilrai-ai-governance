# VigilRAI Community Edition — environment template
# Powered by Ztechnium. One organization. Copy to .env for local development.
# Never commit real secrets.

# --- Required (development defaults shown) ---
DATABASE_URL=postgresql://rai_user:rai_password@localhost:5434/rai_gateway
REDIS_URL=redis://localhost:6380

# --- Optional feature flags ---
ENABLE_CACHE=true
ENABLE_CASES=true
ENABLE_RAG=false
ENABLE_XAI=true
ENABLE_ETHICS_EVAL=true

# --- Security (development-only defaults — change for any shared environment) ---
JWT_SECRET_KEY=dev-only-change-me
REQUIRE_API_KEY=true
ADMIN_TOKEN=dev-admin-token-change-me
REQUIRE_STEP_UP=true
STEP_UP_TOKEN=dev-step-up-token-change-me
ADMIN_BOOTSTRAP_EMAIL=admin@raigateway.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
# Sample systems on this one instance. Leave false for an empty first install.
ENABLE_REFERENCE_PILOT_SEED=false
EVIDENCE_ENCRYPTION_KEY=dev-only-encryption-key

# --- LLM providers (optional — not required for default test suite) ---
LLM_PROVIDER=openai
LLM_PROVIDER_MODEL=gpt-3.5-turbo
# LLM_PROVIDER_API_KEY=

# --- Observability (optional) ---
LOG_LEVEL=INFO
# OTEL_ENDPOINT=http://localhost:4317

# --- Build metadata (set in CI) ---
# GIT_COMMIT_SHA=
# BUILD_TIME=
# SCHEMA_REVISION=

# --- Frontend (control-plane-ui) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_ADMIN_TOKEN=dev-admin-token-change-me

# --- Sign-in and email links (this instance only; no public signup) ---
APP_PUBLIC_URL=http://localhost:3000
AUTH_ACCESS_TOKEN_MINUTES=480
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SET_COOKIES=false

# --- Transactional email (Resend SMTP). Leave EMAIL_ENABLED=false for local/dev. ---
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=VigilRAI
# EMAIL_FROM_ADDRESS=no-reply@your-verified-domain.com
# EMAIL_REPLY_TO=support@your-domain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
# SMTP_PASSWORD=<RESEND_API_KEY>
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_DOCS_URL=https://docs.example.com
